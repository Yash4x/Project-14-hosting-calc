# Production Environment Variables
# IMPORTANT: Replace these values with your own secure values!

# Database Configuration
DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD_HERE

# JWT Secret Keys (generate new secure keys)
# Use: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_TO_SECURE_JWT_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET_KEY=CHANGE_ME_TO_SECURE_REFRESH_SECRET_MIN_32_CHARS

# Domain Configuration
DOMAIN=yourdomain.com
EMAIL=your-email@example.com
